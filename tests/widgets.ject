import "../src/lib" as gui

let changed = fn(event) -> event.value
let clicked = fn(event) -> event.id

let title_input = gui.text_input("title", "Title")
assert(title_input.value == "", "text input must apply its default value")
assert(title_input.on_change == nil, "text input callback must be optional")

let area = gui.multiline("notes", "Notes", "hello", changed)
assert(area.value == "hello", "multiline initial value must be preserved")
assert(type_of(area.on_change) == "lambda", "multiline callback must be preserved")

let check = gui.checkbox("done", "Done")
assert(check.value == false, "checkbox must default to unchecked")

let priority_slider = gui.slider("priority", "Priority", 3, 1, 5, changed)
assert(priority_slider.min == 1 and priority_slider.max == 5, "slider bounds must be preserved")
assert(type_of(priority_slider.on_change) == "lambda", "slider callback must be preserved")

let button = gui.button("save", "Save", true, clicked)
assert(button.close == true, "button close behavior must be preserved")
assert(type_of(button.on_click) == "lambda", "button callback must be preserved")

let layout = gui.group("Mixer", [
    gui.row([gui.number_input("bpm", "BPM", 120), gui.select("wave", "Wave", ["sine", "square"], "sine")]),
    gui.grid(2, [gui.toggle("a", "A"), gui.toggle("b", "B")])
])
assert(layout.kind == "group", "group constructor")
assert(layout.children[0].kind == "row", "nested row constructor")
assert(layout.children[1].columns == 2, "grid columns")
assert(gui.value_text("status", "Status: ").kind == "value_text", "bound text constructor")
assert(gui.meter("level", "Level").kind == "meter", "bound meter constructor")

let native_plot = {
    kind: "plot",
    id: "metrics",
    text: "Resource usage",
    chart: "line",
    height: 280,
    labels: ["10:00", "10:01", "10:02"],
    series: [
        {name: "CPU", values: [21, 33, 28], color: "#4f86f7"},
        {name: "Memory", values: [38, 41, 45]}
    ]
}
assert(gui.validate(gui.document("Chart", [native_plot])), "native plot validates")

let document = gui.document("Studio", [layout, priority_slider, button], 900, 640, {bpm: 120}, "midnight")
assert(document.title == "Studio", "document title")
assert(document.width == 900 and document.height == 640, "document dimensions")
assert(document.state.bpm == 120, "document initial state")
assert(document.theme == "midnight", "document theme")
assert(len(gui.THEMES) == 6, "published theme list")
assert(gui.validate(document), "headless native validation")
assert(gui.dispatch(document, "priority", "change", 4) == 4, "change callbacks cross the native ABI")

let callback_document = gui.document("Callbacks", [
    gui.button("save", "Save", false, fn(event) -> {set: {last_id: event.id}, close: event.kind == "click"}),
    gui.slider("gain", "Gain", 0, 0, 10, fn(event) -> {set: {gain: event.values.gain}})
], state={ready: true})
let click_action = gui.dispatch(callback_document, "save", "click", true)
assert(click_action.set.last_id == "save" and click_action.close, "click callback result must round-trip")
let change_action = gui.dispatch(callback_document, "gain", "change", 7)
assert(change_action.set.gain == 7, "change event state must contain the new value")

let missing_rejected = false
try
    gui.dispatch(document, "missing", "click", true)
catch err
    assert(type_of(err) == "string", "dispatch errors cross the ABI")
    missing_rejected = true
end
assert(missing_rejected, "dispatch must reject unknown widget IDs")

assert(gui.code("x").kind == "code", "code constructor")
assert(gui.link("site", "https://example.com").url == "https://example.com", "link constructor")
assert(gui.badge("new").kind == "badge", "badge constructor")
assert(gui.wrap([]).kind == "wrap", "wrapping layout constructor")
assert(gui.card([]).kind == "card", "card constructor")
assert(gui.collapsible("More", []).open == true, "collapsible constructor")
assert(gui.password("secret", "Password").kind == "password", "password constructor")
assert(gui.radio("mode", "Mode", ["a", "b"], "a").value == "a", "radio constructor")

let decorated = gui.visible(gui.enabled(gui.with_tooltip(gui.button("go", "Go"), "Continue"), false), true)
assert(decorated.tooltip == "Continue", "tooltip modifier")
assert(decorated.enabled == false and decorated.visible == true, "visibility modifiers")

let invalid_rejected = false
try
    gui.validate({title: "Broken", widgets: [gui.button("save", "One"), gui.button("save", "Two")]})
catch err
    assert(type_of(err) == "string", "native validation errors cross the ABI")
    invalid_rejected = true
end
assert(invalid_rejected, "headless validation must reject duplicate IDs")

let invalid_plot_rejected = false
try
    gui.validate(gui.document("Invalid chart", [{
        kind: "plot",
        id: "broken-plot",
        chart: "line",
        height: 280,
        series: [{values: [1, "bad"]}]
    }]))
catch
    invalid_plot_rejected = true
end
assert(invalid_plot_rejected, "native plot validation rejects non-numeric data")

let seeded_document = gui.document("Initial state", [
    gui.button("inspect", "Inspect", false, fn(event) -> event.values),
    gui.visible(gui.column([
        gui.text_input("name", "Name", "default"),
        gui.checkbox("ready", "Ready"),
        gui.slider("gain", "Gain", 3)
    ]), false)
], state={name: "override"})
let seeded_values = gui.dispatch(seeded_document, "inspect", "click", true)
assert(seeded_values.name == "override", "explicit state overrides widget defaults")
assert(seeded_values.ready == false and seeded_values.gain == 3, "callbacks see hidden widget defaults")

# Reactive apps run the same transitions headlessly as they do in a window.
fn counter_view(state)
    let widgets = [
        gui.heading("Count: " + state.count),
        gui.button("increment", "Increment"),
        gui.text_input("name", "Name", "Ada"),
        gui.button("quit", "Quit", true)
    ]
    if state.count >= 2
        widgets = push(widgets, gui.label("Two reached"))
    end
    return widgets
end
fn counter_update(event)
    if event.id == "increment"
        return {set: {count: event.values.count + 1}}
    end
end
let counter = gui.application("Counter", counter_view, counter_update, state={count: 0})
let updated = gui.replay(counter, [
    {id: "increment", kind: "click", value: true},
    {id: "increment", kind: "click", value: true},
    {id: "name", kind: "change", value: "Lin"}
])
assert(updated.values.count == 2, "app events patch persistent state")
assert(updated.values.name == "Lin", "input state survives view rebuilding")
assert(updated.widgets[0].text == "Count: 2", "view refreshes after events")
assert(len(updated.widgets) == 5, "views can change the widget tree")
let stopped = gui.replay(counter, [
    {id: "quit", kind: "click", value: true},
    {id: "increment", kind: "click", value: true}
])
assert(stopped.closed and stopped.values.count == 0, "close stops event replay")
